{
  "name": "@jingerpie/dataview-react",
  "version": "0.1.0-alpha.1",
  "description": "Headless React providers and hooks for Ocean DataView",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jingerpie/dataview.git"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nuqs": {
      "types": "./dist/nuqs/index.d.ts",
      "import": "./dist/nuqs/index.js"
    },
    "./nuqs/server": {
      "types": "./dist/nuqs/server.d.ts",
      "import": "./dist/nuqs/server.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "@jingerpie/dataview-core": "workspace:^",
    "@tanstack/react-query": "^5.90.0",
    "nuqs": "^2.8.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "nuqs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sparkyidea/config": "workspace:*",
    "@jingerpie/dataview-core": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@types/react": "catalog:",
    "nuqs": "catalog:",
    "react": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
