{
  "name": "@jingerpie/dataview-core",
  "version": "0.1.0-alpha.1",
  "description": "Framework-neutral types, validators, URL codecs, and query schemas for Ocean DataView",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jingerpie/ocean-dataview.git"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/types/register.d.ts",
      "import": "./dist/types/register.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "chrono-node": "^2.9.0",
    "date-fns": "^4.1.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@sparkyidea/config": "workspace:*",
    "chrono-node": "catalog:",
    "date-fns": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
