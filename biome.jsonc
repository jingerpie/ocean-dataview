{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/next"],
  "linter": {
    "rules": {
      "complexity": {
        "noVoid": "off"
      }
    }
  },
  "overrides": [
    {
      // Registry output installed by `shadcn add`; refreshed, not hand-edited
      "includes": [
        "examples/next-demo/components/dataview/**",
        "examples/next-demo/components/ui/**",
        "examples/next-demo/hooks/**",
        "examples/next-demo/lib/**"
      ],
      "assist": { "enabled": false },
      "formatter": { "enabled": false },
      "linter": { "enabled": false }
    }
  ]
}
